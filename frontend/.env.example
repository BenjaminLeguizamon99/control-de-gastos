# Solo valores públicos: todo lo VITE_* queda visible en el JS servido.
# Nunca pongas acá la secret key de Supabase ni la conexión a la base.
# Copiá este archivo a .env (ignorado por git) y completá los valores.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Sin barra final
VITE_API_URL=http://localhost:8000
