# Pooler de Supabase en session mode (5432, IPv4); nunca la conexion directa (IPv6-only). Password alfanumerica.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password-alfanumerica>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# URL del proyecto, sin barra final.
SUPABASE_URL=https://<ref>.supabase.co
# JSON: lista de UUID de usuarios autorizados.
ALLOWED_USER_IDS=["<uuid-de-tu-usuario>"]
# JSON: origenes permitidos por CORS.
CORS_ORIGINS=["http://localhost:5173"]
# Publica; solo la usan los curl de verificacion, el backend la ignora.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
